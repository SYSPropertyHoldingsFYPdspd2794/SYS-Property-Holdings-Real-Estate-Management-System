<IfModule mod_expires.c>
    ExpiresActive On
    # Force users' browsers to cache CSS, JS, and fonts locally for one year, reducing repeated requests to InfinityFree.
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    
    # Cache static network diagrams for 1 month
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
    # Force GZIP compression at the network transport layer to significantly reduce file size.
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript
</IfModule>